  grado            String?  @db.VarChar(50)
  nivel            String?  @db.VarChar(50)
  subnivel         String?  @db.VarChar(50)
  opcion_educativa String?  @db.VarChar(100)
  tipo             String?  @db.VarChar(50)
  item             String?  @db.VarChar(50)
  campo_formativo  String?  @db.VarChar(50)
  opcion_respuesta Int?
  estudiantes      Int?
  porcentaje       Decimal? @db.Decimal
